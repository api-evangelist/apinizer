{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apinizer Endpoints Gateways API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Gateways",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Gateways",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apinizer.com/v1/gateways"
          },
          "docs": "List all API gateways managed in the Apinizer platform."
        },
        {
          "info": {
            "name": "Create Gateway",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.apinizer.com/v1/gateways",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new API gateway in the Apinizer platform."
        }
      ]
    }
  ],
  "bundled": true
}